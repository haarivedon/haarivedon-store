# ---------------------------------------------------------------------------
# Shared by the API app and Prisma (packages/db). Copy to .env at the repo root.
# ---------------------------------------------------------------------------

# MongoDB Atlas (recommended): mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority
# Local (needs a replica set for Prisma): mongodb://localhost:27017/haarivedon?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority"

# apps/api
API_PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API (REST + Socket.IO).
CORS_ORIGIN="http://localhost:3000"
# Shared secret for admin-only endpoints and the admin realtime room.
ADMIN_API_KEY=""
