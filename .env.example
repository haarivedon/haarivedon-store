# Prisma + MongoDB connection string.
# MongoDB Atlas (recommended): mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority
# Local (needs a replica set for Prisma): mongodb://localhost:27017/haarivedon?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority"
