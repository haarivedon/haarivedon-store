# ---------------------------------------------------------------------------
# Shared by the API app and Prisma (packages/db). Copy to .env at the repo root.
# ---------------------------------------------------------------------------

# MongoDB Atlas (recommended): mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority
# Local (needs a replica set for Prisma): mongodb://localhost:27017/haarivedon?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/haarivedon?retryWrites=true&w=majority"

# apps/api
API_PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API (REST + Socket.IO).
CORS_ORIGIN="http://localhost:3000"
# Shared secret for admin-only endpoints and the admin realtime room.
ADMIN_API_KEY=""

# Kundali (CR-2) — unset KUNDALI_PROVIDER means the built-in watermarked sample.
# Set KUNDALI_PROVIDER="vedastro" for real Swiss-Ephemeris charts via VedAstro;
# with URL/key blank it uses the free hosted host and the FreeAPIUser key
# (~5 req/min shared globally — fine to prototype; buy the $1/mo tier or
# self-host for go-live). "http" uses the generic single-POST provider instead.
KUNDALI_PROVIDER=""
KUNDALI_API_URL=""
KUNDALI_API_KEY=""
KUNDALI_CHART_STYLE="north"
# VedAstro ayanamsa: LAHIRI | RAMAN | KRISHNAMURTI | YUKTESHWAR
KUNDALI_AYANAMSA="LAHIRI"

# Object storage. Without R2 credentials files are written under STORAGE_DIR,
# which is fine locally but not on a host with an ephemeral disk.
STORAGE_DIR=".data/storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET=""
R2_MEDIA_BUCKET=""
R2_PUBLIC_URL=""

# Admin platform (CR-3)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
# Must share the apex domain with the web app, e.g. .haarivedon.com
AUTH_COOKIE_DOMAIN=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
REVALIDATE_SECRET=""
WEB_URL="http://localhost:3000"

# Store / Razorpay (store CR). Empty keys disable the store (Buy Now hidden,
# checkout refuses) while the catalogue keeps working. Use rzp_test_* keys for
# development. KEY_ID is publishable; keep the secret and webhook secret private.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set to the secret configured on the Razorpay webhook; blank skips webhook
# verification (fine locally, where the client-side verify marks orders paid).
RAZORPAY_WEBHOOK_SECRET=""
