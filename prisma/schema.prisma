// Haarivedon data layer — Prisma with MongoDB.
// Backend lives fully in Next.js (Route Handlers in app/api/*).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Session booking requests submitted from the Book a Session page.
model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  phone         String
  // one of: personal-consultation | prediction-reading | guidance-session | other
  sessionType   String
  preferredDate DateTime
  preferredTime String
  message       String   @default("")
  // pending | confirmed | completed | cancelled
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bookings")
}

/// Prediction / reading requests submitted from the Predictions page.
model PredictionRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String
  dateOfBirth  DateTime
  timeOfBirth  String   @default("")
  placeOfBirth String
  // career | relationships | health | finance | general
  focusArea    String   @default("general")
  question     String   @default("")
  // pending | in-progress | delivered
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prediction_requests")
}

/// Sacred products / energy tools shown in the shop.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String
  price       Int
  currency    String   @default("INR")
  image       String
  category    String   @default("sacred-objects")
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

/// Services offered, listed on the Services page.
model Service {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  description   String
  icon          String   @default("sparkles")
  startingPrice Int?
  currency      String   @default("INR")
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

/// Client testimonials.
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  quote     String
  rating    Int      @default(5)
  location  String   @default("")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

/// Blog / journal posts.
model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @default("")
  coverImage  String
  tags        String[]
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}
