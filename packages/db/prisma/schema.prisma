// Haarivedon data layer — Prisma with MongoDB.
// Shared across the monorepo via @repo/db — the API app (apps/api) owns all access.

generator client {
  provider = "prisma-client-js"
  // `native` for local dev. `debian-openssl-3.0.x` is the Render runtime
  // (Ubuntu 22.04 / OpenSSL 3), where the API now lives. `rhel-openssl-3.0.x`
  // is kept for the legacy Vercel Functions bundle. Keep in sync if a deploy
  // target's OpenSSL changes.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Session booking requests submitted from the Book a Session page.
///
/// The client's confirmed field list (docs/PLAN.md §3.2) is name, mobile and
/// date / time / place of birth — there is no appointment slot, so the old
/// preferredDate/preferredTime pair is gone and `sessionType` is optional,
/// kept only for routing the enquiry. Birth coordinates are stored alongside
/// the place name because the Kundali calculation needs them (CR-2).
model Booking {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String
  /// Optional: not in the client's field list, but the only way to email a PDF.
  email        String?
  // personal-consultation | prediction-reading | guidance-session | other
  sessionType  String   @default("personal-consultation")
  /// The service chosen on the Services page, if the booking started there.
  service      String   @default("")
  dateOfBirth  DateTime
  timeOfBirth  String
  birthPlace   String
  birthLat     Float
  birthLng     Float
  birthTz      String   @default("Asia/Kolkata")
  message      String   @default("")
  // pending | confirmed | completed | cancelled
  status       String   @default("pending")
  /// Human-readable booking reference (e.g. HV-7F3K9Q) once a fee is paid.
  reference    String   @default("")
  /// Session fee paid in whole rupees (0 if booking is free / unpaid).
  amount       Int      @default(0)
  // none | pending | paid | failed — the session fee via Razorpay.
  paymentStatus String  @default("none")
  razorpayOrderId   String @default("")
  razorpayPaymentId String @default("")
  /// Calendly booking captured in the "schedule" step (empty until scheduled).
  /// The event URI is enough to confirm a slot was picked; the exact time comes
  /// from Calendly's own confirmation email (no Calendly API token needed).
  calendlyEventUri   String @default("")
  calendlyInviteeUri String @default("")
  // pending | ready | failed — the PDF is generated after the booking is saved.
  kundaliStatus String  @default("pending")
  /// Private-bucket object key; never served directly.
  kundaliKey   String   @default("")
  /// One-time token handed to the submitter so only they can download the PDF.
  kundaliToken String   @default("")
  kundaliError String   @default("")
  /// Admin-only, never exposed publicly.
  internalNote String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([razorpayOrderId])
  @@map("bookings")
}

/// Prediction / reading requests submitted from the Predictions page.
model PredictionRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String
  dateOfBirth  DateTime
  timeOfBirth  String   @default("")
  placeOfBirth String
  /// Coordinates + zone for the Kundali, from the city picker (like Booking).
  birthLat     Float    @default(0)
  birthLng     Float    @default(0)
  birthTz      String   @default("Asia/Kolkata")
  // career | relationships | health | finance | general
  focusArea    String   @default("general")
  question     String   @default("")
  // pending | in-progress | delivered
  status       String   @default("pending")
  // pending | ready | failed — the chart is generated after the request is saved.
  kundaliStatus String  @default("pending")
  /// Private-bucket object key; never served directly.
  kundaliKey   String   @default("")
  /// One-time token handed to the submitter so only they can download the PDF.
  kundaliToken String   @default("")
  kundaliError String   @default("")
  /// Admin-only, never exposed publicly.
  internalNote String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prediction_requests")
}

/// Sacred products / energy tools shown in the shop.
///
/// The catalogue is five families at different depths (see docs/PLAN.md §2),
/// so `family` is the top-level grouping, `category` the sub-tier within it
/// (precious / semi-precious / organic for gemstones, nepali / indonesian for
/// rudraksha), and `attributes` holds the facts only that family has — mukhi
/// and deity, or Mohs hardness and ruling planet. The zod schema in
/// @repo/contract discriminates on `family` so those stay type-checked.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  // yantra | gemstone | rudraksha | mala | crystal | idol
  family      String   @default("crystal")
  category    String   @default("general")
  summary     String   @default("")
  description String   @default("")
  // null means "enquire for price"; 0 means free.
  price       Int?
  currency    String   @default("INR")
  images      String[]
  attributes  Json?
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(false)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

/// Services offered, listed on the Services page.
model Service {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  summary       String   @default("")
  description   String   @default("")
  icon          String   @default("Sparkles")
  // null means "enquire for price". This is the "Rate".
  startingPrice Int?
  // null means no discount; shown struck-through against the Rate when set.
  discountedPrice Int?
  currency      String   @default("INR")
  highlights    String[]
  image         String   @default("")
  // Grouping for the services section: coaching | readings | energy | vastu | other.
  // Optional so existing documents (missing the field) still read on MongoDB.
  category      String?  @default("")
  // Surfaced as a highlighted offering at the top of the section (the Vastu pages).
  featured      Boolean? @default(false)
  order         Int      @default(0)
  published     Boolean  @default(false)
  updatedBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

/// Client testimonials.
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  quote     String
  rating    Int      @default(5)
  location  String   @default("")
  published Boolean  @default(true)
  order     Int      @default(0)
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

/// Blog / journal posts.
model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   @default("")
  coverImage  String   @default("")
  tags        String[]
  // Drafts are created unpublished; the client publishes from the admin.
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  order       Int      @default(0)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

/// Courses offered (CR-1, docs/PLAN.md §3.1).
///
/// Basic/advanced pairs are separate records linked by `relatedSlugs`, so
/// each is independently priced and enrollable while still cross-linking.
/// Seeded rows carry structure only and stay unpublished until the client
/// fills in copy, price and imagery through the admin.
model Course {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  /// One of the 14 categories in docs/PLAN.md §10.
  category     String
  // basic | advanced | premium
  level        String   @default("basic")
  // live | recorded | hybrid | workshop
  format       String   @default("live")
  summary      String   @default("")
  description  String   @default("")
  outline      String[]
  duration     String   @default("")
  language     String   @default("Hindi / English")
  /// null means "enquire for price"; 0 means free.
  price        Int?
  currency     String   @default("INR")
  image        String   @default("")
  relatedSlugs String[]
  certificate  Boolean  @default(false)
  featured     Boolean  @default(false)
  published    Boolean  @default(false)
  order        Int      @default(0)
  updatedBy    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("courses")
}

/// Enquiries about a specific course or product.
///
/// One model rather than one per kind: the fields are identical, the inbox
/// wants them in one list, and "ask about this" is the same act whichever
/// page it starts from. Products and courses are catalogue items — there is no
/// store with carts or order tracking. An enquiry is either a free "ask about
/// this" or a Razorpay-paid "reserve this", which the admin then fulfils by
/// hand. The payment fields stay empty (`paymentStatus = "none"`) for a free
/// ask; a paid reserve carries the Razorpay ids and amount so the inbox shows
/// what was paid.
model Enquiry {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  // course | product
  kind              String
  name              String
  email             String
  phone             String
  /// Slug of the course or product being asked about.
  itemSlug          String
  /// Denormalised so the inbox reads correctly even if the item is renamed.
  itemTitle         String   @default("")
  message           String   @default("")
  // pending | contacted | enrolled | closed
  status            String   @default("pending")
  /// Human-readable reservation number (e.g. HV-7F3K9Q) for a paid reserve;
  /// empty for a free ask. What the buyer and admin quote to each other.
  reference         String   @default("")
  /// How many units a paid reserve was for (1 for a free ask).
  quantity          Int      @default(1)
  /// Total paid in whole rupees (0 for a free ask).
  amount            Int      @default(0)
  // none (free ask) | pending | paid | failed
  paymentStatus     String   @default("none")
  /// Razorpay ids for a paid reserve; empty for a free ask.
  razorpayOrderId   String   @default("")
  razorpayPaymentId String   @default("")
  /// Admin-only, never exposed publicly.
  internalNote      String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kind, status])
  @@index([razorpayOrderId])
  @@map("enquiries")
}

/// Admin accounts for the CMS (CR-3, docs/PLAN.md §3.3).
///
/// One role: everyone who can log in can do everything. A two-person practice
/// does not need a permission matrix, and every role check is a place to get
/// authorization wrong (§3.4).
model AdminUser {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  email        String         @unique
  name         String         @default("")
  /// scrypt, stored as "scrypt:<salt-hex>:<hash-hex>".
  passwordHash String
  /// Set when an account is suspended; blocks login and kills its sessions.
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@map("admin_users")
}

/// Server-side sessions, so logging out everywhere is a delete.
model AdminSession {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  /// SHA-256 of the cookie token — a database leak must not yield live sessions.
  tokenHash String     @unique
  userId    String     @db.ObjectId
  user      AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String     @default("")
  ip        String     @default("")
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("admin_sessions")
}

/// Editable page copy (CR-3). One row per key, validated by the zod schema
/// for that key in @repo/contract — six keys, listed in docs/PLAN.md §12.
model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  data      Json
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

/// Uploaded imagery. Files live in object storage; this is the index.
model Media {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  url       String
  alt       String   @default("")
  width     Int      @default(0)
  height    Int      @default(0)
  bytes     Int      @default(0)
  mimeType  String   @default("image/webp")
  createdAt DateTime @default(now())

  @@map("media")
}

/// Birth-place lookup.
///
/// Searched server-side rather than shipped to the browser: the bundled list
/// that used to back the picker had to stay small enough to download with the
/// page, which capped it at a couple of hundred cities. Imported by
/// `pnpm db:seed:places` so the dataset never enters the repository.
model Place {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  /// Lower-cased name, for prefix matching without a case-insensitive scan.
  search     String
  /// State or province.
  region     String   @default("")
  country    String   @default("IN")
  lat        Float
  lng        Float
  timezone   String   @default("Asia/Kolkata")
  /// Bigger places sort first, so "Kanpur" beats "Kanpur Dehat".
  population Int      @default(0)

  @@index([search, population])
  @@map("places")
}
