// Haarivedon data layer — Prisma with MongoDB.
// Shared across the monorepo via @repo/db — the API app (apps/api) owns all access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Session booking requests submitted from the Book a Session page.
model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  phone         String
  // one of: personal-consultation | prediction-reading | guidance-session | other
  sessionType   String
  preferredDate DateTime
  preferredTime String
  message       String   @default("")
  // pending | confirmed | completed | cancelled
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bookings")
}

/// Prediction / reading requests submitted from the Predictions page.
model PredictionRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String
  dateOfBirth  DateTime
  timeOfBirth  String   @default("")
  placeOfBirth String
  // career | relationships | health | finance | general
  focusArea    String   @default("general")
  question     String   @default("")
  // pending | in-progress | delivered
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prediction_requests")
}

/// Sacred products / energy tools shown in the shop.
///
/// The catalogue is five families at different depths (see docs/PLAN.md §2),
/// so `family` is the top-level grouping, `category` the sub-tier within it
/// (precious / semi-precious / organic for gemstones, nepali / indonesian for
/// rudraksha), and `attributes` holds the facts only that family has — mukhi
/// and deity, or Mohs hardness and ruling planet. The zod schema in
/// @repo/contract discriminates on `family` so those stay type-checked.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  // yantra | gemstone | rudraksha | mala | crystal | idol
  family      String   @default("crystal")
  category    String   @default("general")
  summary     String   @default("")
  description String   @default("")
  // null means "enquire for price"; 0 means free.
  price       Int?
  currency    String   @default("INR")
  images      String[]
  attributes  Json?
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(false)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

/// Services offered, listed on the Services page.
model Service {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  summary       String   @default("")
  description   String   @default("")
  icon          String   @default("Sparkles")
  // null means "enquire for price".
  startingPrice Int?
  currency      String   @default("INR")
  highlights    String[]
  image         String   @default("")
  order         Int      @default(0)
  published     Boolean  @default(false)
  updatedBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

/// Client testimonials.
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  quote     String
  rating    Int      @default(5)
  location  String   @default("")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

/// Blog / journal posts.
model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @default("")
  coverImage  String
  tags        String[]
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}
