{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:pull": "dotenv -e ../../.env -- prisma db pull",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:admin": "dotenv -e ../../.env -- tsx prisma/seed-admin.ts",
    "db:seed:places": "dotenv -e ../../.env -- tsx prisma/seed-places.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
